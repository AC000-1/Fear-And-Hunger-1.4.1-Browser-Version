ndent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Mà có rất nhiều điều trong "]},{"code":401,"indent":0,"parameters":["lời tiên tri chuẩn xác một cách đáng sợ.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Nó nói về 'người đàn ông tóc vàng' và đồng thời cũng là "]},{"code":401,"indent":0,"parameters":["'người sáng ngang với các vị thần về cả sức mạnh lẫn sắc đẹp'...\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Hah! Ta tưởng lũ cựu thần ai cũng xấu như nhau.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Đừng nói với ta rằng cô tin lời đó nhé?\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Nilvan tân thần được cho là tuyệt sắc giai nhân. "]},{"code":401,"indent":0,"parameters":["Giống như kẻ bị giày vò thời xưa...\""]},{"code":230,"indent":0,"parameters":[80]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Những văn tự cũng đề cập rằng 'người thống nhất các quốc "]},{"code":401,"indent":0,"parameters":["gia gây chiến, không phải bằng sức mạnh từ cây trượng hoàng kim, "]},{"code":401,"indent":0,"parameters":["mà là bằng sức mạnh của hàng chục cái cái đinh ba'.\" "]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Chà lũ quốc vương kia đều ghét ta ở điểm đó, "]},{"code":401,"indent":0,"parameters":["nên ta công nhận lấy nó vậy...\""]},{"code":230,"indent":0,"parameters":